<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="bifrost_cFS_GroundSystem.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:bifrost_cFS_GroundSystem"
    xmlns:pages="clr-namespace:bifrost_cFS_GroundSystem.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="bifrost_cFS_GroundSystem">

    <TabBar>
        <ShellContent Title="Home" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        <ShellContent Title="Telemetry" ContentTemplate="{DataTemplate pages:TelemetryPage}" Route="TelemetryPage" />
    </TabBar>

</Shell>
